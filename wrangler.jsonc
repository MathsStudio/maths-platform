{
  "name": "maths-platform",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/account", "/account/*", "/admin", "/admin/*", "/app", "/app/*", "/logout", "/unsubscribe"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "mathsstudio" }],
  "vars": { "FROM_EMAIL": "MathsStudio <hello@mathsstudio.co.uk>" },
  "triggers": { "crons": ["17 3 * * *"] }
}
